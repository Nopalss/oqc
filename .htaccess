# ==============================================================================
# OQC System - Security & Access Control Configuration
# ==============================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block direct web access to all hidden files/dotfiles (e.g., .env, .git, .gitignore)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct web access to sensitive backup/database/log files
<FilesMatch "\.(env|sql|sqlite|log|ini|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Specific RewriteRule to block any direct attempt to request .env
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.env - [F,L,NC]
</IfModule>

# 5. Block public access to debug & utility scripts
<FilesMatch "^(truncate|_debug.*|_test.*)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 6. Enable Gzip / Deflate Compression for High Speed LAN Transfer
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/wasm image/svg+xml
</IfModule>

# 7. Leverage Browser Caching for Static Assets (CSS, JS, Fonts, Images, Wasm)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType application/x-javascript "access plus 7 days"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/wasm "access plus 1 month"
</IfModule>

# 8. Set HTTP Headers for Static vs Dynamic Files
<IfModule mod_headers.c>
    # Cache static assets locally on client PC
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|wasm|ttf|woff|woff2)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
    
    # Prevent client browser from caching dynamic PHP pages with old data
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

