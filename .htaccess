# ==============================================================================
# OQC System - Security & Access Control Configuration
# ==============================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block direct web access to all hidden files/dotfiles (e.g., .env, .git, .gitignore)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block direct web access to sensitive backup/database/log files
<FilesMatch "\.(env|sql|sqlite|log|ini|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Specific RewriteRule to block any direct attempt to request .env
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.env - [F,L,NC]
</IfModule>

# 5. Block public access to debug & utility scripts
<FilesMatch "^(truncate|_debug.*|_test.*)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
