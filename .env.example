# ==============================================================================
# OQC Core System - Environment Configuration Template
# ==============================================================================
# Usage:
# 1. Copy this file to '.env' on your production or local server:
#    cp .env.example .env
# 2. Adjust database credentials and environment settings below.
#
# Web Server Security:
# - Apache: Protected automatically by root .htaccess (blocks access to .env)
# - Nginx: Add this rule to your server block:
#     location ~ /\.(env|git) { deny all; return 404; }
# ==============================================================================

APP_NAME="OQC Core System"
APP_ENV=production
APP_DEBUG=false

# Database Connection (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=oqc_db
DB_USER=your_production_db_user
DB_PASS=your_production_db_password
